# LLM 配置（必填）
# 默认路线：本地 Ollama（零费用，数据不出本机）
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen3.8-gsq-rco-iq3s
# none = 不生成 thinking token。本地实测比 low 快 2~3 倍且 content 必非空
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=3072
AGENT_MAX_ITER=8
LLM_TIMEOUT=600
# >0 启用 LLM 响应缓存（秒）；相同 prompt 重跑直接命中，debug 零成本
LLM_CACHE_TTL=3600

# ── 备选：StepFun 云端 step-5-preview（须填真实 key）──────────
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
# MODEL_NAME=step-5-preview
# LLM_REASONING_EFFORT=
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=180

# ── 备选：OpenRouter ────────────────────────────────────────
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=deepseek/deepseek-chat-v3-0324

# ── 下单开关（默认关，建议保持关）─────────────────────────────
# 不设 / 留空 = 分析流水线只出建议：execute_buy、execute_sell、set_stop_loss
# 三个工具一律拒绝执行并返回 advice_only=true，portfolio.json 与
# history/trades_*.json 不会被改动。crew.py 每交易日 15:35 由计划任务无人值守
# 触发，别让 LLM 在日报里自己决定下不下单。
# 设 1/true/yes/on 才放行真实下单（run_virtual_v4.py 的模拟盘直接调
# portfolio_tracker，不受本开关影响）。
# ALLOW_AGENT_TRADING=

# 微信通知（可选）
WECHAT_WEBHOOK_URL=your_webhook_url_here
