# LLM 配置（必填，用于 CrewAI 多智能体分析）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=deepseek/deepseek-chat-v3-0324

# 备选：阿里云 DashScope
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus

# LLM Provider 切换（default=OpenAI兼容, lms-local=LM Studio, mimo=MiMo）
# LLM_PROVIDER=lms-local

# MiMo 模型配置（LLM_PROVIDER=mimo 时使用）
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.mimo.ai/v1
# MIMO_MODEL_NAME=free/mimo-v2.5-pro-cn

# LM Studio 本地配置（LLM_PROVIDER=lms-local 时使用，端口由 start-lm-studio.ps1 写入 .lm-studio-port.txt）
# OPENAI_API_KEY=lm-studio
# MODEL_NAME=gemma-4-12B-it-Q4_K_M

# 交易模式（mock=本地虚拟盘, efinance=东方财富模拟, real=实盘）
TRADING_MODE=mock

# 信号推送模式（可选，实盘起步推荐）
# true=不自动交易，每轮将止损/止盈/买入建议推送到企业微信，人工确认后手动下单
# 需同时配置 WECHAT_WEBHOOK_URL；与 run_loop.bat 定时循环配合使用
# SIGNAL_ONLY=true

# 实盘交易配置（TRADING_MODE=real 时使用）
# BROKER_CODE=ht          # ht=华泰, dfcf=东方财富, ths=同花顺
# LIVE_TRADE_CONFIRM=true  # 实盘下单前需人工确认

# 企业微信通知（可选，未配置则跳过推送）
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# openclaw 微信推送目标（crew.py 用，未配置则跳过发送）
# WECHAT_TARGET=your_wechat_user_id

# 掘金量化仿真（可选，双轨同步参与绩效排名/投资大赛）
# 1. 掘金仿真官网注册并创建"股票"类型仿真账户（初始资金与本地虚拟盘一致）
# 2. Token/账户ID 在官网 交易-账户管理-API交易指引 处复制
# 3. 搭建桥接环境（gmtrade 仅支持 Python<=3.10，脚本自动装独立 .gmenv）:
#    powershell -ExecutionPolicy Bypass -File setup_gm_env.ps1
# 4. 验证: .gmenv\Scripts\python.exe gm_sync_worker.py --dry-run
# GM_ENABLED=true
# GM_TOKEN=your_gm_token_here
# GM_ACCOUNT_ID=your_gm_account_id_here
# GM_ENDPOINT=api.myquant.cn:9000
# GM_PYTHON=D:\path\to\python310.exe
